{
  "name": "@bbg-next/runtime",
  "version": "0.0.0",
  "description": "The browser shell for bbg-next",
  "files": [
    "dist"
  ],
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json",
    "./testing": "./testing/index.ts"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit && vue-tsc --noEmit -p tsconfig.test.json"
  },
  "dependencies": {
    "@bbg-next/core": "workspace:*",
    "@bbg-next/plugin": "workspace:*",
    "@bbg-next/view": "workspace:*"
  },
  "inlinedDependencies": {
    "entities": "8.1.0",
    "linkify-it": "6.1.0",
    "markdown-it": "15.0.2",
    "mdurl": "2.1.0",
    "punycode.js": "2.3.1",
    "uc.micro": "3.0.0"
  }
}
