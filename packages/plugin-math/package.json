{
  "name": "@bbg-next/plugin-math",
  "version": "0.0.0",
  "description": "Typesets TeX formulas as MathML, fetching Temml only for pages that show one",
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  },
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bbg-next/plugin": "workspace:*",
    "@mdit/plugin-tex": "^1.1.2",
    "temml": "^0.13.5"
  },
  "devDependencies": {
    "@bbg-next/core": "workspace:*",
    "markdown-it": "^15.0.2"
  }
}
