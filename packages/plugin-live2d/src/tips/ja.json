    {
      "selector": ":is([data-bbg-plugin=\"twikoo\"], [data-bbg-plugin=\"waline\"], [data-bbg-plugin=\"rustaline\"]) textarea",
      "text": ["コメントを書くの？やさしい言葉でね～", "送る前に見直してね～"]
