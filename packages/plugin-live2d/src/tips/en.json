{
  "mouseover": [
    {
      "selector": "#live2d",
      "text": ["Hey, hands off~", "Your mouse is in the wrong place!", "Meow?", "What are you doing?"]
    },
    {
      "selector": "#waifu-tool-hitokoto",
      "text": ["Guess what I'm about to say?", "Want to hear a line from hitokoto?"]
    },
    {
      "selector": "#waifu-tool-asteroids",
      "text": ["Fancy a round of Asteroids?", "This button says “do not press”…", "Want to play a game with me?"]
    },
    {
      "selector": "#waifu-tool-switch-model",
      "text": ["Want to meet someone else?", "Shall I call one of my friends?"]
    },
    {
      "selector": "#waifu-tool-switch-texture",
      "text": ["Want to see me in something new?", "Which outfit should I try this time?"]
    },
    {
      "selector": "#waifu-tool-photo",
      "text": ["Taking a picture of me? Say cheese!", "Just keep smiling~"]
    },
    {
      "selector": "#waifu-tool-info",
      "text": ["Want to know more about me?", "My story's written down here~"]
    },
    {
      "selector": "#waifu-tool-quit",
      "text": ["Time to say goodbye?", "We'll meet again, right…?"]
    },
    {
      "selector": "a.bbg-anchor",
      "text": ["That's a link to this section. You can share it as it is~"]
    },
    {
      "selector": "bbg-nav a",
      "text": ["Off to “{text}”?", "This way to “{text}”~"]
    },
    {
      "selector": ":is(bbg-article-list, bbg-archive-view, bbg-article-view) a[href*=\"tag/\"]",
      "text": ["Want to see more under “{text}”?", "Browsing by tag is handy too~"]
    },
    {
      "selector": ":is(bbg-article-list, bbg-archive-view) a[href*=\"article/\"]",
      "text": ["Going to read “{text}”?", "“{text}” sounds interesting~"]
    },
    {
      "selector": "bbg-article-view a[href*=\"article/\"]",
      "text": ["On to “{text}” next~"]
    },
    {
      "selector": "bbg-article-list a[href*=\"list/\"]",
      "text": ["There's more on the other pages~", "Older posts are further on~"]
    },
    {
      "selector": ":is(bbg-article-view, bbg-page-view) pre",
      "text": ["That code looks tricky…", "Want me to read that code for you? …I can't either~"]
    },
    {
      "selector": ":is(bbg-article-view, bbg-page-view) img",
      "text": ["What a lovely picture~", "What's in it? Let me see too~"]
    },
    {
      "selector": "[data-bbg-plugin=\"hitokoto\"]",
      "text": ["Well said~"]
    },
    {
      "selector": "[data-bbg-plugin=\"announcement\"]",
      "text": ["There's an announcement here, do give it a read~"]
    },
    {
      "selector": "[data-bbg-plugin=\"friends\"]",
      "text": ["These are all friends of the owner. Go pay them a visit~"]
    },
    {
      "selector": ":is([data-bbg-plugin=\"twikoo\"], [data-bbg-plugin=\"waline\"], [data-bbg-plugin=\"rustaline\"])",
      "text": ["Got something to say? Leave a comment here~"]
    },
    {
      "selector": "bbg-footer",
      "text": ["That's the bottom~", "All done? Want to head back up?"]
    }
  ],
  "click": [
    {
      "selector": "#live2d",
      "text": [
        "That was an accident… right?",
        "Poke me again and I'll get cross!",
        "Stop poking, I'm working here~",
        "Hey, that tickles~"
      ]
    },
    {
      "selector": ":is([data-bbg-plugin=\"twikoo\"], [data-bbg-plugin=\"waline\"], [data-bbg-plugin=\"rustaline\"]) textarea",
      "text": ["Writing a comment? Be kind~", "Give it a read-through before you send it~"]
    },
    {
      "selector": "a.bbg-anchor",
      "text": ["This section's address is in the address bar now. Copy it to share~"]
    }
  ],
